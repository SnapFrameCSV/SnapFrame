{
  "name": "snapframe",
  "displayName": "Snapframe — Code Screenshot",
  "description": "Turn a code selection into a clean, shareable PNG that keeps your editor's real theme and font. No accounts, no telemetry, no network.",
  "version": "0.0.1",
  "publisher": "snapframe",
  "pricing": "Trial",
  "license": "SEE LICENSE IN ../LICENSE",
  "private": true,
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=22"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "screenshot",
    "code screenshot",
    "polacode",
    "codesnap",
    "carbon",
    "snapcode",
    "snippet",
    "image",
    "share code",
    "social",
    "png",
    "svg",
    "presentation",
    "documentation",
    "twitter",
    "linkedin",
    "slides",
    "pull request",
    "code image",
    "ray.so"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/SnapFrameCSV/snapframe.git"
  },
  "bugs": {
    "url": "https://github.com/SnapFrameCSV/snapframe/issues"
  },
  "homepage": "https://github.com/SnapFrameCSV/snapframe#readme",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "snapframe.capture",
        "title": "Capture Selection",
        "category": "Snapframe"
      },
      {
        "command": "snapframe.quickSnap",
        "title": "Quick Snap (last settings)",
        "category": "Snapframe"
      },
      {
        "command": "snapframe.enterLicence",
        "title": "Enter Licence Key",
        "category": "Snapframe"
      },
      {
        "command": "snapframe.buyPro",
        "title": "Buy Pro…",
        "category": "Snapframe"
      },
      {
        "command": "snapframe.openSettings",
        "title": "Open Settings",
        "category": "Snapframe"
      },
      {
        "command": "snapframe.captureBefore",
        "title": "Capture as 'Before' (Pro)",
        "category": "Snapframe"
      },
      {
        "command": "snapframe.captureAfter",
        "title": "Capture as 'After' and Compare (Pro)",
        "category": "Snapframe"
      },
      {
        "command": "snapframe.captureTerminal",
        "title": "Capture Terminal Selection (Pro)",
        "category": "Snapframe"
      },
      {
        "command": "snapframe.savePreset",
        "title": "Save Preset… (Pro)",
        "category": "Snapframe"
      },
      {
        "command": "snapframe.applyPreset",
        "title": "Apply Preset… (Pro)",
        "category": "Snapframe"
      },
      {
        "command": "snapframe.deletePreset",
        "title": "Delete Preset… (Pro)",
        "category": "Snapframe"
      },
      {
        "command": "snapframe.exportPresets",
        "title": "Export Presets to JSON… (Pro)",
        "category": "Snapframe"
      },
      {
        "command": "snapframe.importPresets",
        "title": "Import Presets from JSON… (Pro)",
        "category": "Snapframe"
      }
    ],
    "keybindings": [
      {
        "command": "snapframe.capture",
        "key": "ctrl+alt+shift+s",
        "mac": "cmd+alt+shift+s",
        "when": "editorTextFocus"
      },
      {
        "command": "snapframe.quickSnap",
        "key": "ctrl+alt+shift+q",
        "mac": "cmd+alt+shift+q",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "snapframe.capture",
          "group": "9_snapframe@1",
          "when": "editorHasSelection"
        }
      ]
    },
    "configuration": {
      "title": "Snapframe",
      "properties": {
        "snapframe.background.type": {
          "type": "string",
          "enum": [
            "solid",
            "gradient",
            "transparent"
          ],
          "enumDescriptions": [
            "A single colour (background.color).",
            "A two-colour gradient (background.gradient).",
            "No backdrop — the image keeps a transparent background. Pro."
          ],
          "default": "gradient",
          "description": "Fill behind the code frame: a single colour, a two-colour gradient, or (Pro) nothing."
        },
        "snapframe.background.color": {
          "type": "string",
          "default": "#1e1e2e",
          "description": "Solid background colour (CSS colour). Used when background.type is \"solid\"."
        },
        "snapframe.background.gradient": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "maxItems": 2,
          "default": [
            "#8caaee",
            "#ca9ee6"
          ],
          "description": "Start and end colours of the gradient background. Used when background.type is \"gradient\"."
        },
        "snapframe.background.gradientAngle": {
          "type": "number",
          "minimum": 0,
          "maximum": 360,
          "default": 135,
          "description": "Gradient direction in degrees (0 = upwards, 90 = to the right, 135 = the default diagonal). Pro."
        },
        "snapframe.background.gradientStops": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "default": [],
          "description": "Two or more gradient colours, evenly spaced, overriding background.gradient. Leave empty to use background.gradient. Pro."
        },
        "snapframe.background.image": {
          "type": "string",
          "default": "",
          "description": "Absolute path to a .png/.jpg/.webp/.gif drawn behind the frame, scaled to cover the image (5 MB max). Pro."
        },
        "snapframe.caption.text": {
          "type": "string",
          "default": "",
          "description": "A caption or handle (for example @yourname) drawn under the frame. Empty for none. Pro."
        },
        "snapframe.caption.color": {
          "type": "string",
          "default": "#ffffff",
          "description": "Caption colour (your brand colour). Pro."
        },
        "snapframe.caption.position": {
          "type": "string",
          "enum": [
            "left",
            "center",
            "right"
          ],
          "default": "right",
          "description": "Where the caption sits under the frame. Pro."
        },
        "snapframe.layout.comparison": {
          "type": "string",
          "enum": [
            "side-by-side",
            "stacked"
          ],
          "default": "side-by-side",
          "description": "How the two cards of a before/after comparison are arranged. Pro."
        },
        "snapframe.layout.labels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "maxItems": 2,
          "default": [
            "Before",
            "After"
          ],
          "description": "Labels shown above the two cards of a comparison. Pro."
        },
        "snapframe.qr.text": {
          "type": "string",
          "default": "",
          "description": "A URL or short text (up to 213 bytes) to draw as a QR code under the frame — typically your repo, gist or docs link. Generated locally. Empty for none. Pro."
        },
        "snapframe.qr.size": {
          "type": "number",
          "minimum": 48,
          "maximum": 240,
          "default": 80,
          "description": "Side length of the QR code in pixels at 1×. Pro."
        },
        "snapframe.highlightLines": {
          "type": "string",
          "default": "",
          "description": "File line numbers to highlight, as shown in the gutter — for example \"12-14, 20\". Empty for none. Pro."
        },
        "snapframe.highlightColor": {
          "type": "string",
          "default": "rgba(255,255,255,0.08)",
          "description": "Colour of the highlight band behind highlighted lines. Pro."
        },
        "snapframe.focusDim": {
          "type": "boolean",
          "default": false,
          "description": "When lines are highlighted, fade every other line. Pro."
        },
        "snapframe.callouts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "line": {
                "type": "integer",
                "description": "File line number, as shown in the gutter."
              },
              "text": {
                "type": "string",
                "description": "Short label (up to 40 characters)."
              }
            },
            "required": [
              "line",
              "text"
            ]
          },
          "default": [],
          "description": "Small labels pinned to the right edge of a line, for example [{ \"line\": 12, \"text\": \"the bug\" }]. Pro."
        },
        "snapframe.padding": {
          "type": "number",
          "minimum": 0,
          "maximum": 256,
          "default": 32,
          "description": "Space in pixels between the code frame and the edge of the image."
        },
        "snapframe.shadow": {
          "type": "boolean",
          "default": true,
          "description": "Draw a soft drop shadow under the code frame."
        },
        "snapframe.cornerRadius": {
          "type": "number",
          "minimum": 0,
          "maximum": 64,
          "default": 12,
          "description": "Corner radius of the code frame in pixels."
        },
        "snapframe.windowControls": {
          "type": "boolean",
          "default": true,
          "description": "Show the three macOS-style window dots in the frame's title bar."
        },
        "snapframe.lineNumbers": {
          "type": "boolean",
          "default": true,
          "description": "Show line numbers, starting at the first selected line."
        },
        "snapframe.titleBar": {
          "type": "boolean",
          "default": true,
          "description": "Show a title bar with the file name above the code."
        },
        "snapframe.wrapColumn": {
          "type": "number",
          "minimum": 0,
          "maximum": 200,
          "default": 0,
          "description": "Soft-wrap captured lines longer than this many characters. 0 disables wrapping."
        },
        "snapframe.scale": {
          "type": "number",
          "enum": [
            1,
            2,
            3,
            4
          ],
          "default": 2,
          "description": "Export resolution multiplier. 2× is sharper on high-DPI screens. 3× and 4× are Pro (they fall back to 2× without a key)."
        },
        "snapframe.exportFolder": {
          "type": "string",
          "default": "",
          "description": "Folder where images are saved. Leave empty to be asked each time."
        },
        "snapframe.copyToClipboardAfterExport": {
          "type": "boolean",
          "default": false,
          "description": "After exporting, also copy the image to the clipboard."
        }
      }
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node22 --external:vscode --outfile=dist/extension.js",
    "pretest": "tsc -p tsconfig.json",
    "test": "node --test \"out/test/**/*.test.js\"",
    "generate-icon": "node scripts/generate-icon.js",
    "package": "npm run build && node scripts/copy-license.js && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.28.2",
    "jsqr": "^1.4.0",
    "playwright": "^1.63.0",
    "typescript": "^5.6.0"
  }
}
